{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.X1pheR/qmd-mcp",
  "title": "QMD MCP",
  "description": "Local QMD search and bounded index maintenance through a Streamable HTTP MCP server.",
  "websiteUrl": "https://github.com/X1pheR/qmd-mcp",
  "repository": {
    "url": "https://github.com/X1pheR/qmd-mcp",
    "source": "github",
    "id": "1333668707"
  },
  "version": "0.1.5",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/x1pher/qmd-mcp:v0.1.5",
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--publish",
          "value": "127.0.0.1:8181:8181"
        },
        {
          "type": "named",
          "name": "--volume",
          "value": "{configDir}:/config:ro",
          "variables": {
            "configDir": {
              "description": "Host directory containing index.yml.",
              "format": "filepath",
              "isRequired": true
            }
          }
        },
        {
          "type": "named",
          "name": "--volume",
          "value": "{contentDir}:/vault:ro",
          "variables": {
            "contentDir": {
              "description": "Host directory containing the files to index.",
              "format": "filepath",
              "isRequired": true
            }
          }
        },
        {
          "type": "named",
          "name": "--volume",
          "value": "{dataDir}:/data",
          "variables": {
            "dataDir": {
              "description": "Host directory for the QMD index, model cache, and runtime state.",
              "format": "filepath",
              "isRequired": true
            }
          }
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:8181/mcp"
      }
    }
  ]
}
